//matrix chain multiplication codetantra daa 6.1.3
#include <stdio.h>
#include <limits.h>
int min(int a,int b){
    return (a < b) ? a : b;
}
int main(){
    int n;
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }
    int dp[n][n];
    for (int i = 1; i < n; i++){
        dp[i][i] = 0;
    }
    for (int l = 2; l < n; l++){
        for (int i = 1; i < n - l + 1; i++){
            int j = i + l - 1;
            dp[i][j] = INT_MAX;
            for (int k = i; k < j; k++){
                int cost=dp[i][k]+dp[k+1][j]+arr[i-1]*arr[k]*arr[j];
                dp[i][j] = min(dp[i][j], cost);
            }
        }
    }
    printf("%d\n", dp[1][n - 1]);
    return 0;
}
